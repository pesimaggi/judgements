# Lögbrunnur — environment
#
# Copy to .env.local for development, or set these as service variables on
# Railway. Everything below is optional except DATABASE_URL: the app runs, and
# the well is simply absent, with none of it set.
#
# Only the variables a deployment actually turns are listed. The ingestion
# adapters read a few dozen more (INGEST_*, LAGASAFN_*, EURLEX_*, …); those are
# documented next to the adapters that read them, and none of them affects a
# running web service.

# ---------------------------------------------------------------------------
# Database and search
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logbrunnur

# "postgres" (default) or "meilisearch". Switches every search this app does,
# including the well's — see src/lib/search.
# SEARCH_PROVIDER=postgres
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_API_KEY=
# MEILI_CITATION_ID_CAP=5000

# ---------------------------------------------------------------------------
# The well ("Spyrja brunninn") — provider and model
#
# With NEITHER key set the well is off, and off means absent: the launcher
# never renders and /api/ask answers 503.
# ---------------------------------------------------------------------------

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# "openai" | "anthropic". Only needed when both keys are set — then this is the
# switch. It wins outright, including when its own key is missing, because
# naming a provider and silently getting the other one is worse than an error.
# ASK_PROVIDER=openai

# ASK_MODEL_OPENAI=gpt-5.6-terra
# ASK_MODEL_ANTHROPIC=claude-opus-5
# Overrides whichever of the two above is active. For a quick one-off.
# ASK_MODEL=

# ---------------------------------------------------------------------------
# The well — effort per stage
#
# PRECEDENCE: the per-stage variable, then ASK_EFFORT, then the default below.
# ASK_EFFORT on its own still governs the answer exactly as it did before the
# per-stage variables existed, so a deployment that sets only ASK_EFFORT is
# unaffected by all of this.
#
# Values: low | medium | high | xhigh | max (both APIs take the same five).
# Nothing selects high or above on its own: the complexity classifier chooses
# between ASK_EFFORT_SIMPLE and ASK_EFFORT_COMPLEX and never beyond them.
# ---------------------------------------------------------------------------

# ASK_EFFORT=              # the old single knob; still the fallback for both branches
# ASK_PLAN_EFFORT=low      # planning: six short strings, does not need more
# ASK_EFFORT_SIMPLE=low    # a question with one legal issue in it
# ASK_EFFORT_COMPLEX=medium # several issues, conflicting sources, historical law, EEA/EU
# ASK_VERIFY_EFFORT=low    # the citation verifier, when it is on

# ---------------------------------------------------------------------------
# The well — the optional stages
#
# Both are OFF by default and both cost an extra model call on every question.
# Switch one on, measure it with `npm run eval:ask`, and switch it off again.
# ---------------------------------------------------------------------------

# Model-assisted citation verification. Each cited claim is checked against
# only the evidence it cites; unsupported claims are qualified in the answer.
# The deterministic validation runs either way — this never replaces it.
# ASK_VERIFY_CITATIONS=0

# Model-assisted reranking of the retrieved candidates. It can only reorder:
# it cannot add a source or remove one, and any failure falls back to the
# deterministic ranking.
# ASK_RERANK_WITH_MODEL=0

# ---------------------------------------------------------------------------
# The well — retrieval size and text budgets
# ---------------------------------------------------------------------------

# ASK_MAX_CANDIDATES=30    # gathered, then ranked (5-120)
# ASK_MAX_SOURCES=10       # shown to the model and to the reader (3-30)
# ASK_EVIDENCE_CHARS=1200  # context around a matched passage in a judgment
# ASK_PROVISION_CHARS=2400 # of an article's text, cut at a paragraph boundary

# Token ceilings. Generous enough for reasoning, small enough that a runaway
# cannot bill for a minute and return nothing.
# ASK_ANSWER_MAX_TOKENS=8000
# ASK_PLAN_MAX_TOKENS=3000
# ASK_VERIFY_MAX_TOKENS=4000

# ---------------------------------------------------------------------------
# The well — per-stage timeouts, in milliseconds
#
# Planning, reranking and verification degrade on a timeout: the question is
# still answered without them. Retrieval and the answer fail the request, and
# /api/ask reports 504 rather than leaving the reader watching a bucket.
# ---------------------------------------------------------------------------

# ASK_TIMEOUT_PLAN_MS=20000
# ASK_TIMEOUT_RETRIEVE_MS=20000
# ASK_TIMEOUT_ANSWER_MS=90000
# ASK_TIMEOUT_VERIFY_MS=30000
# ASK_TIMEOUT_RERANK_MS=20000

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# TAG_CACHE_TTL_MS=300000

# ---------------------------------------------------------------------------
# EFTA Court decision PDFs
# ---------------------------------------------------------------------------
# The Court publishes each decision as a PDF under /download/, and
# eftacourt.int's robots.txt disallows that path for every user agent. With
# this unset the adapter stores the case *record* — parties, subject, the
# Court's own note and the list of published documents — which is a complete,
# searchable register but not judgment text.
#
# scripts/ingest-all.sh sets it to 1, so THIS DEPLOYMENT FETCHES THE PDFs. The
# decision is recorded there and in README (see "EFTA Court"), deliberately,
# rather than left to a default. Export it as 0 to turn that off.
#
# If you fork this repository, that is your decision to make again — read the
# robots.txt yourself. It also names GPTBot, OAI-SearchBot, CCBot and
# Google-Extended specifically.
# EFTA_FETCH_DOCUMENTS=1
